{
  "name": "@podwiki/web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.11.1",
  "engines": {
    "node": ">=24 <26",
    "npm": ">=11 <12"
  },
  "scripts": {
    "generate:search-index": "node scripts/generate-search-index.mjs",
    "predev": "npm run generate:search-index",
    "dev": "next dev",
    "prebuild": "npm run generate:search-index",
    "build": "next build",
    "postbuild": "npm run check:search-trace",
    "start": "next start",
    "prelint": "npm run generate:search-index",
    "lint": "eslint .",
    "pretypecheck": "npm run generate:search-index",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:search-index",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:search-trace": "node scripts/check-search-trace.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "motion": "^13.0.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
